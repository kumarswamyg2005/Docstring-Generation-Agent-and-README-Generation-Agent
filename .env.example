# AI Model Configuration
# Optional: Configure AI provider for enhanced documentation

# Provider 1 Configuration
AI_PROVIDER_1_API_KEY=your_api_key_here
AI_PROVIDER_1_MODEL=your_model_name

# Provider 2 Configuration (Alternative)
AI_PROVIDER_2_API_KEY=your_api_key_here
AI_PROVIDER_2_MODEL=your_model_name

# Provider 3 Configuration (Alternative)
AI_PROVIDER_3_TOKEN=your_token_here

# Agent Configuration
DEFAULT_DOCSTRING_STYLE=google  # Options: google, numpy, sphinx
ENABLE_AI_ENHANCEMENT=true  # Use AI for better descriptions
MAX_TOKENS=4000
TEMPERATURE=0.3  # Lower for more consistent output
